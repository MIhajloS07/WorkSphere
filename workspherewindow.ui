                QLineEdit, QComboBox {
                    background-color: #080c1d;
                    color: #ffffff;
                    border: 1px solid #334155;
                    border-radius: 8px;
                    padding: 10px 14px;
                    font-size: 14px;
                    font-family: 'Segoe UI';
