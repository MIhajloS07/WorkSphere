      <!-- PROJECT FORM PAGE -->
      <widget class="QWidget" name="projectFormPage">
       <layout class="QVBoxLayout" name="verticalLayoutProjectFormPage">
        <property name="leftMargin"><number>30</number></property>
        <property name="topMargin"><number>20</number></property>
        <property name="rightMargin"><number>30</number></property>
        <property name="bottomMargin"><number>20</number></property>
        <item>
         <spacer name="spacerProjFormTop">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
         </spacer>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayoutProjFormWrapper">
          <item>
           <spacer name="spacerProjFormLeft">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
          <item>
           <widget class="QWidget" name="projectFormContainerWidget">
            <property name="minimumWidth"><number>500</number></property>
            <property name="maximumWidth"><number>550</number></property>
            <property name="styleSheet">
             <string notr="true">
                #projectFormContainerWidget {
                    background-color: #0f172a;
                    border: 1px solid #1e293b;
                    border-radius: 16px;
                }
                QLabel {
                    color: #cbd5e1;
                    font-size: 14px;
                    font-weight: 600;
                    font-family: 'Segoe UI';
                }
                QLineEdit, QComboBox, QDateEdit {
                    background-color: #080c1d;
                    color: #ffffff;
                    border: 1px solid #334155;
                    border-radius: 8px;
                    padding: 10px 14px;
                    font-size: 14px;
                    font-family: 'Segoe UI';
                }
                QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
                    border: 1px solid #38bdf8;
                }
                QComboBox::drop-down {
                    border: none;
                    width: 30px;
                }
                QComboBox QAbstractItemView {
                    background-color: #0f172a;
                    color: #ffffff;
                    selection-background-color: #1e293b;
                    border: 1px solid #1e293b;
                }
             </string>
            </property>
            <layout class="QVBoxLayout" name="verticalLayoutProjFormContent">
             <property name="leftMargin"><number>35</number></property>
             <property name="topMargin"><number>30</number></property>
             <property name="rightMargin"><number>35</number></property>
             <property name="bottomMargin"><number>35</number></property>
             <property name="spacing"><number>20</number></property>

             <item>
              <widget class="QLabel" name="labelProjFormHeader">
               <property name="text"><string>Add / Edit Project</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="styleSheet">
                <string notr="true">color: #ffffff; font-size: 24px; font-weight: bold; margin-bottom: 10px;</string>
               </property>
              </widget>
             </item>

             <item>
              <layout class="QFormLayout" name="formLayoutProjFields">
               <property name="horizontalSpacing"><number>20</number></property>
               <property name="verticalSpacing"><number>18</number></property>
               <property name="labelAlignment"><set>Qt::AlignLeft|Qt::AlignVCenter</set></property>

               <item row="0" column="0">
                <widget class="QLabel" name="labelProjName">
                 <property name="text"><string>Project Name</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QLineEdit" name="lineProjName">
                 <property name="placeholderText"><string>Enter project name...</string></property>
                </widget>
               </item>

               <item row="1" column="0">
                <widget class="QLabel" name="labelProjClient">
                 <property name="text"><string>Client</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLineEdit" name="lineProjClient">
                 <property name="placeholderText"><string>Enter client name...</string></property>
                </widget>
               </item>

               <item row="2" column="0">
                <widget class="QLabel" name="labelProjStatus">
                 <property name="text"><string>Status</string></property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QComboBox" name="comboProjStatus">
                 <item><property name="text"><string>In Progress</string></property></item>
                 <item><property name="text"><string>Completed</string></property></item>
                 <item><property name="text"><string>Pending</string></property></item>
                 <item><property name="text"><string>On Hold</string></property></item>
                </widget>
               </item>

               <item row="3" column="0">
                <widget class="QLabel" name="labelProjBudget">
                 <property name="text"><string>Budget</string></property>
                </widget>
               </item>
               <item row="3" column="1">
                <widget class="QLineEdit" name="lineProjBudget">
                 <property name="placeholderText"><string>Enter budget amount...</string></property>
                </widget>
               </item>

               <item row="4" column="0">
                <widget class="QLabel" name="labelProjDeadline">
                 <property name="text"><string>Deadline</string></property>
                </widget>
               </item>
               <item row="4" column="1">
                <widget class="QDateEdit" name="dateProjDeadline">
                 <property name="calendarPopup"><bool>true</bool></property>
                </widget>
               </item>
              </layout>
             </item>

             <item>
              <layout class="QHBoxLayout" name="horizontalLayoutProjFormButtons">
               <property name="spacing"><number>12</number></property>
               <item>
                <widget class="QPushButton" name="btnCancelProject">
                 <property name="text"><string>Cancel</string></property>
                 <property name="styleSheet">
                  <string notr="true">
                      QPushButton {
                          background-color: #334155; color: #ffffff; border: none; border-radius: 8px;
                          padding: 12px; font-size: 15px; font-weight: bold; font-family: 'Segoe UI';
                      }
                      QPushButton:hover { background-color: #475569; }
                  </string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnSaveProject">
                 <property name="text"><string>Save Project</string></property>
                 <property name="styleSheet">
                  <string notr="true">
                      QPushButton {
                          background-color: #2563eb; color: #ffffff; border: none; border-radius: 8px;
                          padding: 12px; font-size: 15px; font-weight: bold; font-family: 'Segoe UI';
                      }
                      QPushButton:hover { background-color: #1d4ed8; }
                  </string>
                 </property>
                </widget>
               </item>
              </layout>
             </item>

            </layout>
           </widget>
          </item>
          <item>
           <spacer name="spacerProjFormRight">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
         </layout>
        </item>
        <item>
         <spacer name="spacerProjFormBottom">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
         </spacer>
        </item>
       </layout>
      </widget>

