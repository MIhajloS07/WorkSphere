               <item row="3" column="1">
                <widget class="QLineEdit" name="lineEmpPosition">
                 <property name="placeholderText"><string>Enter worker position...</string></property>
                </widget>
               </item>
              </layout>
             </item>

             <item>
              <layout class="QHBoxLayout" name="horizontalLayoutEmpFormButtons">
               <property name="spacing"><number>12</number></property>
               <item>
                <widget class="QPushButton" name="btnCancelEmployee">
                 <property name="text"><string>Cancel</string></property>
                 <property name="styleSheet">
                  <string notr="true">
                      QPushButton {
                          background-color: #334155; color: #ffffff; border: none; border-radius: 8px;
                          padding: 12px; font-size: 15px; font-weight: bold; font-family: 'Segoe UI';
